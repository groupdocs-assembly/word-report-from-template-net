# Source is normalised to LF in the repository and checked out per platform.
* text=auto

# Templates, data documents and images must stay byte-for-byte: a line-ending
# conversion breaks an Office package, a PDF cross-reference table and an image.
*.docx binary
*.xlsx binary
*.pptx binary
*.odt  binary
*.ods  binary
*.odp  binary
*.msg  binary
*.pdf  binary
*.png  binary
*.jpg  binary

# Visual Studio is happier with CRLF in these.
*.sln    text eol=crlf
*.csproj text eol=crlf
